    {
      "id": 14,
      "type": "logs",
      "title": "À quoi ressemble un rapport de saccade overlay ?",
      "description": "Une ligne par rapport : client, build, durée de l'image, temps passé dans l'étape renderOverlay, affichage.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"game-telemetry\", source=\"$source\", event=\"perf_spike\"} | json | cls_cause=\"overlay\" | line_format \"client={{.cls_client}} build={{.report_build}} image={{.report_frameMs}}ms renderOverlay={{.report_work_details_renderOverlay}}ms largeur={{.report_graphics_width}}px bloom={{.report_graphics_bloom}} carte={{.server_map}}\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
