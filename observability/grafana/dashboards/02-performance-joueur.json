{
  "uid": "gt-player-perf",
  "title": "2. Performance côté joueur",
  "description": "Qui subit des saccades, depuis quand et pourquoi ? Typologie des rapports de performance, par cause, build et matériel.",
  "tags": [
    "game-telemetry"
  ],
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "2026-09-19T22:00:00.000Z",
    "to": "2026-09-26T22:30:00.000Z"
  },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Combien de rapports de saccade uniques sur la période ?",
      "description": "Rapports perf_spike hors doublons (cls.duplicate).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"game-telemetry\", source=\"$source\", event=\"perf_spike\"} | json dup=\"cls.duplicate\" | dup!=\"true\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Combien de clients distincts ont signalé une saccade ?",
      "description": "Le client est extrait de l'identifiant du rapport (P-<client>-<n>). Dimension à forte cardinalité : elle vit dans les logs, pas dans les métriques.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (client) (count_over_time({service=\"game-telemetry\", source=\"$source\", event=\"perf_spike\"} | json client=\"cls.client\" [$__range])))",
          "queryType": "instant"
